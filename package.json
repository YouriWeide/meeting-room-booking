{
  "name": "roombooking",
  "version": "0.0.0",
  "private": true,
  "description": "Meeting room booking system — .NET API + Angular frontend",
  "scripts": {
    "api": "dotnet run --project api/src/RoomBooking.Api",
    "api:build": "dotnet build api/RoomBooking.sln",
    "web": "npm --prefix web run start",
    "web:build": "npm --prefix web run build",
    "web:install": "npm --prefix web install"
  }
}
